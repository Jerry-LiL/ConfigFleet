upstream configfleet_app {
{% for nginx_proxy_upstream in nginx_proxy_upstream_servers %}
    server {{ nginx_proxy_upstream }} max_fails=3 fail_timeout=10s;
{% endfor %}
}

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name {{ nginx_proxy_server_name }};
    client_max_body_size {{ nginx_proxy_client_max_body_size }};

    location /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /app/ {
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
        proxy_pass http://configfleet_app/;
    }
}
